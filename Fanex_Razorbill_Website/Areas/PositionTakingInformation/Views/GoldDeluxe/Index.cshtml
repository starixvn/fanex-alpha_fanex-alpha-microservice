@using System.Web.Optimization;
@using Fanex.Razorbill.Module.PositionTaking.Models.GoldDeluxe;
@model GoldDeluxeModel
@{
    Page.Title = Resources.Lang.lblPositionTaking;
    Layout = "../Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/_Components/PagingHeader/GoldDeluxeStyles",
        "~/_Components/Paging/GoldDeluxeStyles",
        "~/bundles/PositionTaking/GoldDeluxeStyles")
}
<div id="page_main">
    <div id="header_main">@Resources.Lang.lblPositionTaking</div>
    <div class="ptcontainer">
        @Html.Partial("~/Areas/PositionTakingInformation/Views/Shared/_PositionTakingHeader.cshtml", 1)
        <div id="positionTakingData">
            @Html.Partial("~/Areas/PositionTakingInformation/Views/GoldDeluxe/_PositionTaking.cshtml", Model)
        </div>
    </div>
</div>
<input type="hidden" id="hiddenCustomerId" value="@ViewBag.CustomerId" />
<input type="hidden" id="hiddenDownline" value="" />
@section Scripts {
    <script type="text/javascript" src="@Url.Content("~/_Components/AGEWnd/AGEWnd.js")"></script>
    @Scripts.Render("~/bundles/PositionTaking/GoldDeluxeScripts")
}
<script type="text/javascript">
    window.rootUrl = '@Url.Content("~")';
    var loginId = '@ViewBag.CustomerId';
    var subAccId = '@ViewBag.SubAccId';
    var roleId = '@ViewBag.RoleId';
    var langKey = '@ViewBag.LangKey';
</script>
